# Development Environment Variables
# For local development, you can use a placeholder URL or set up a real Convex project

# Convex Configuration
# Option 1: Use a placeholder URL for development (app may have warnings but will run)
VITE_CONVEX_URL=https://placeholder.convex.cloud

# Option 2: Set up a real Convex project at https://convex.dev and use your actual URL
# VITE_CONVEX_URL=https://your-actual-deployment.convex.cloud

# Optional configurations
VITE_APP_TITLE=Reaching for the Stars - Space Exploration Data Story